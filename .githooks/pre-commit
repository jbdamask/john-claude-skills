#!/usr/bin/env bash
# Auto-bump a plugin's patch version whenever its files are staged for commit.
# Claude Code only re-syncs an installed plugin when the version in
# .claude-plugin/plugin.json changes, so a content change without a bump
# silently never reaches installed copies.
#
# Wired via: git config core.hooksPath .githooks  (see README)
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

plugins=$(echo "$staged" | sed -n 's|^plugins/\([^/]*\)/.*|\1|p' | sort -u)
[ -z "$plugins" ] && exit 0

for name in $plugins; do
  manifest="plugins/$name/.claude-plugin/plugin.json"
  [ -f "$manifest" ] || continue

  head_ver=$(git show "HEAD:$manifest" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null || echo "")
  staged_ver=$(git show ":$manifest" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null || echo "")

  # Already bumped by hand (staged version differs from HEAD) -> leave it alone.
  if [ -n "$staged_ver" ] && [ "$staged_ver" != "$head_ver" ]; then
    continue
  fi

  new_ver=$(python3 - "$manifest" <<'EOF'
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
major, minor, patch = (data.get("version") or "0.0.0").split(".")
data["version"] = f"{major}.{minor}.{int(patch) + 1}"
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
print(data["version"])
EOF
)
  git add "$manifest"
  echo "pre-commit: bumped $name to $new_ver"
done

# Keep marketplace.json per-plugin versions in sync with each plugin.json
# (Claude Desktop reads versions from the marketplace entry).
python3 - <<'EOF'
import json, os, subprocess
mp = ".claude-plugin/marketplace.json"
if os.path.exists(mp):
    with open(mp) as f:
        data = json.load(f)
    changed = False
    for entry in data.get("plugins", []):
        pj = f"plugins/{entry['name']}/.claude-plugin/plugin.json"
        if os.path.exists(pj):
            ver = json.load(open(pj)).get("version")
            if ver and entry.get("version") != ver:
                entry["version"] = ver
                changed = True
    if changed:
        with open(mp, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        subprocess.run(["git", "add", mp], check=True)
        print("pre-commit: synced marketplace.json plugin versions")
EOF
